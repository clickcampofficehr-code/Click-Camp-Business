# ==============================================================================
# Click Camp Business and Technology Services Limited
# Production Environment Variables & Deployment Configuration (Step 5 Checklist)
# ==============================================================================

# Node Environment Flag (Set to production for live deployment)
NODE_ENV=production
VITE_NODE_ENV=production

# Application Base URL (SSL/HTTPS Enforced)
APP_URL="https://portal.clickcamp.tech"
VITE_APP_URL="https://portal.clickcamp.tech"

# Supabase Production PostgreSQL & Realtime API Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="your-private-service-role-key"

# Storage Bucket Identifiers
VITE_STORAGE_BUCKET_AVATARS="avatars"
VITE_STORAGE_BUCKET_DOCUMENTS="statutory-documents"

# Supervisor Emergency Override & Profile Switch Passcode (Enterprise Protected)
VITE_SUPERVISOR_PASSCODE="55821442"

# Security & Compliance Flags
VITE_PRODUCTION_SEC_ENFORCED="true"
VITE_IMMUTABLE_WEBMAIL_ENABLED="true"
VITE_REALTIME_PROFILE_SYNC="true"
VITE_SHIFT_PERSISTENCE_ENABLED="true"

# Gemini AI Operational Copilot API Key (Managed via Cloud Secrets)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
